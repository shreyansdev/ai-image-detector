# AI Image Detector - Environment Configuration Template
# Copy this file to .env in the backend directory and configure according to your environment.

# Path to trained model weights relative to the backend directory
MODEL_WEIGHTS_PATH=ml/model_weights/best_efficientnet_b0.pth

# Maximum allowed file upload size per image in megabytes
MAX_FILE_SIZE_MB=10

# Comma-separated list of allowed origins for CORS security
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Server host and port configuration
HOST=0.0.0.0
PORT=8000
